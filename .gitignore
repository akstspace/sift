# Embedded frontend output is rebuilt from web/. Keep the original project mark
# as a nonempty go:embed placeholder before the first frontend build.
/internal/sift/public/*
!/internal/sift/public/sift.svg

# Local credentials, environment overrides, workspace databases and backups.
.env
.env.*
!.env.example
connection.json
*.db
*.db-shm
*.db-wal

# Full source/dependency license texts are consolidated in THIRD_PARTY_NOTICES.md.
# The distribution notice tree is generated by scripts/collect-licenses.py.
/licenses/

# Local research/browser harnesses are not release inputs. Explicitly retain
# scripts consumed by CI, build, security, installer, release, and operations.
/scripts/*
!/scripts/backend-coverage.py
!/scripts/collect-licenses.py
!/scripts/demo-data.py
!/scripts/generate-icons.py
!/scripts/install.sh
!/scripts/local_api.py
!/scripts/package-docs.json
